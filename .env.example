# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never import into a "use client" file. CI greps the client
# bundle for this value (npm run check:secrets).
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google OAuth (configured inside Supabase Auth -> Providers -> Google)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The bootstrap super admin (§2) is NOT an environment variable. It is a literal
# under "PART 4 — BOOTSTRAP" in supabase/migrations/0001_init.sql; edit it there
# before the first `supabase db push`.

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Web Push (generate with: npx web-push generate-vapid-keys)
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (invisible mode)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Rate limiting. Optional: if unset, the `rate_limits` Postgres table is used
# instead of Upstash (§15).
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
CRON_SECRET=
IP_HASH_SALT=
SENTRY_DSN=
