# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never import into a "use client" file. CI greps the client
# bundle for this value (npm run check:secrets).
SUPABASE_SERVICE_ROLE_KEY=

# The origin the site is served from. This value is for LOCAL WORK ONLY — do
# not copy this line into the hosting dashboard. In production set it to the
# real origin (e.g. https://migrash-gilad.vercel.app, or your custom domain
# once there is one); it is the base for the og:image share card, the sign-up
# confirmation redirect and every link in a notification e-mail. On Vercel it
# may be left unset entirely: `siteUrl()` in lib/utils.ts falls back to the
# deployment's own production domain, and ignores a localhost value there.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google OAuth (configured inside Supabase Auth -> Providers -> Google)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The bootstrap super admin (§2) is NOT an environment variable. It is a literal
# under "PART 4 — BOOTSTRAP" in
# supabase/migrations/00000000000000_init.sql; edit it before the first
# `supabase db push`.

# ---------------------------------------------------------------------------
# Email (sent via Gmail SMTP with the sender's own account)
#
# GMAIL_APP_PASSWORD is an app password, not the account's real password:
# turn on 2-Step Verification for the account first, then generate one at
# https://myaccount.google.com/apppasswords
#
# NOTIFY_FROM_NAME is optional — a display name in front of the address
# (e.g. "מגרש גילעד"). NOTIFY_FROM_EMAIL is also optional; it only overrides
# the contact address web push reports to browsers, which otherwise defaults
# to GMAIL_USER.
# ---------------------------------------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_FROM_NAME=
NOTIFY_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Web Push (generate with: npx web-push generate-vapid-keys)
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (invisible mode)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Rate limiting. Optional: if unset, the `rate_limits` Postgres table is used
# instead of Upstash (§15).
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
CRON_SECRET=
IP_HASH_SALT=
SENTRY_DSN=
